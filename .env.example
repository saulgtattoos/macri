# Variable names only. Real values live in .env (local), .env.test.local (test project)
# and the Vercel dashboard. Never commit values.

# Browser (VITE_ prefix is shipped to every visitor: public values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (Vercel env; read by /api; never prefix with VITE_)
OWNER_USER_ID=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
AFTERCARE_LINK_SECRET=
CONCIERGE_WEBHOOK_URL=
CONCIERGE_SECRET=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Test project only (.env.test.local)
# VITE_SUPABASE_TEST_PROJECT=true
# TEST_OWNER_EMAIL=
# TEST_OWNER_PASSWORD=
# TEST_OTHER_EMAIL=
# TEST_OTHER_PASSWORD=
# CHECK_API_BASE=http://127.0.0.1:3001
