{
  "name": "macri",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dev-api.mjs",
    "dev:test": "vite --mode test",
    "dev:api:test": "node --env-file=.env.test.local scripts/dev-api.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:api": "vitest run tests/api",
    "test:sql": "vitest run tests/sql",
    "test": "vitest run",
    "check:access": "node --env-file=.env.test.local scripts/check-access.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.105.3",
    "nodemailer": "^8.0.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.14.1",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "30.1.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.4",
    "vitest": "5.0.3"
  }
}
