px solid rgba(122, 120, 111, 0.3); color: rgb(122, 120, 111); cursor: pointer; font-family: var(--font-body); font-size: 13px; min-height: 36px; padding: 0px 12px; transition: border-color 0.15s, color 0.15s">Black and Gray Portrait</button><button style="background: transparent; border-radius: 8px; border: 1px solid rgba(122, 120, 111, 0.3); color: rgb(122, 120, 111); cursor: pointer; font-family: var(--font-body); font-size: 13px; min-height: 36px; padding: 0px 12px; transition: border-color 0.15s, color 0.15s">Stippled Shading</button><button style="background: transparent; border-radius: 8px; border: 1px solid rgba(122, 120, 111, 0.3); color: rgb(122, 120, 111); cursor: pointer; font-family: var(--font-body); font-size: 13px; min-height: 36px; padding: 0px 12px; transition: border-color 0.15s, color 0.15s">Per Session</button><button style="background: transparent; border-radius: 8px; border: 1px solid rgba(122, 120, 111, 0.3); color: rgb(122, 120, 111); cursor: pointer; font-family: var(--font-body); font-size: 13px; min-height: 36px; padding: 0px 12px; transition: border-color 0.15s, color 0.15s">Fine Line</button><button style="background: transparent; border-radius: 8px; border: 1px solid rgba(122, 120, 111, 0.3); color: rgb(122, 120, 111); cursor: pointer; font-family: var(--font-body); font-size: 13px; min-height: 36px; padding: 0px 12px; transition: border-color 0.15s, color 0.15s">Simple Design</button></div></div><div style="display: flex; gap: 12px; margin-bottom: 12px"><div style="flex: 1 1 0%"><span style="color: rgb(122, 120, 111); display: block; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; margin-bottom: 6px">Width (in)</span><input placeholder="0" style="background: rgb(30, 30, 27); border-radius: 8px; border: 1px solid rgb(42, 42, 39); box-sizing: border-box; color: rgb(232, 230, 223); font-family: var(--font-mono); font-size: 14px; outline: none; padding: 10px 12px; width: 100%" type="number" value=""></div><div style